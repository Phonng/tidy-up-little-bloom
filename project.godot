; Little Bloom - Android first-person cozy flower sorting prototype
config_version=5

[application]
config/name="Little Bloom"
run/main_scene="res://scenes/main_menu.tscn"
config/description="A cozy first-person flower shop tidy-up game."
config/version="0.1.0"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/little_bloom_icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.91, 0.88, 0.81, 1)

[autoload]
GameState="*res://scripts/autoload/game_state.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"
